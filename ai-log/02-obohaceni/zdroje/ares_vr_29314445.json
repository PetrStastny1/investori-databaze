{"icoId":"29314445","zaznamy":[{"akcie":[{"datumZapisu":"2016-02-12","datumVymazu":"2016-12-16","typAkcie":"NA_JMENO","podobaAkcie":"LISTINNA","pocet":40000,"hodnota":{"typObnos":"KORUNY","hodnota":"250"}},{"datumZapisu":"2016-12-16","typAkcie":"ZVLASTNI_PRAVA","podobaAkcie":"LISTINNA","pocet":1,"text":"Akcie na jméno je označena jako akcie druhu A.\nPráva a povinnosti spojená s tímto\ndruhem akcií jsou uvedena v čl. 4.4.1\nstanov založených ve sbírce listin.\nPřevoditelnost akcie druhu A je omezená\na je podmíněna souhlasem představenstva\na zároveň souhlasem valné hromady za podmínek\nstanovených v čl. 6.14 níže nebo souhlasem\npředstavenstva a zároveň písemným souhlasem\nvšech akcionářů.","hodnota":{"typObnos":"KORUNY","hodnota":"1200000"}},{"datumZapisu":"2016-12-16","typAkcie":"PRIORITNI_NA_JMENO","podobaAkcie":"LISTINNA","pocet":40000,"text":"Akcie je označena jako akcie druhu B.\nPráva a povinnosti spojená s tímto\ndruhem akcií jsou uvedena v čl. 4.4.2\nstanov založených ve sbírce listin.\nPřevoditelnost akcií druhu B je omezená\na je podmíněna předchozím souhlasem\npředstavenstva.","hodnota":{"typObnos":"KORUNY","hodnota":"250"}},{"datumZapisu":"2015-03-26","datumVymazu":"2016-02-12","typAkcie":"NA_JMENO","podobaAkcie":"LISTINNA","pocet":12000,"hodnota":{"typObnos":"KORUNY","hodnota":"251;85"}},{"datumZapisu":"2012-04-02","datumVymazu":"2015-03-26","typAkcie":"NA_MAJITELE","podobaAkcie":"LISTINNA","pocet":12000,"hodnota":{"typObnos":"KORUNY","hodnota":"251;85"}}],"rejstrik":"OR","primarniZaznam":true,"spisovaZnacka":[{"datumZapisu":"2016-02-12","soud":"KSBR","oddil":"B","vlozka":7488},{"datumZapisu":"2012-04-02","datumVymazu":"2016-02-12","soud":"KSBR","oddil":"H","vlozka":159}],"ico":[{"datumZapisu":"2012-04-02","hodnota":"29314445"}],"obchodniJmeno":[{"datumZapisu":"2016-02-12","hodnota":"Y Soft Ventures, a.s."},{"datumZapisu":"2012-04-02","datumVymazu":"2015-03-26","hodnota":"Y Soft Venture Capital SE"},{"datumZapisu":"2015-03-26","datumVymazu":"2016-02-1