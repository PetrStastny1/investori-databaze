,"cisloDomovni":2902,"kodCastiObce":411965,"cisloOrientacni":4,"nazevCastiObce":"Královo Pole","kodAdresnihoMista":25089625,"psc":61200,"textovaAdresa":"Podnikatelská 2902/4, Královo Pole, 61200 Brno","standardizaceAdresy":true,"typCisloDomovni":1},"typAdresy":"SIDLO"},{"datumZapisu":"2012-10-29","datumVymazu":"2015-11-12","adresa":{"kodStatu":"CZ","nazevStatu":"Česká republika","kodKraje":116,"nazevKraje":"Jihomoravský kraj","kodOkresu":3702,"nazevOkresu":"Brno-město","kodObce":582786,"nazevObce":"Brno","kodMestskeCastiObvodu":551007,"kodUlice":36951,"nazevMestskeCastiObvodu":"Brno-Královo Pole","nazevUlice":"Technická","cisloDomovni":2948,"kodCastiObce":411965,"cisloOrientacni":13,"nazevCastiObce":"Královo Pole","kodAdresnihoMista":26714353,"psc":61600,"textovaAdresa":"Technická 2948/13, Královo Pole, 61600 Brno","standardizaceAdresy":true,"typCisloDomovni":1},"typAdresy":"SIDLO"}],"ostatniSkutecnosti":[{"datumZapisu":"2016-02-12","hodnota":"Obchodní společnost Y Soft Ventures SE změnila v důsledku přeměny k 12. únoru 2016 právní formu z evropské akciové společnosti (Societas Europaea) na akciovou společnost podle českého práva."},{"datumZapisu":"2016-12-16","hodnota":"Jediný akcionář společnosti Y Soft Ventures, a.s., rozhodl o zvýšení základního kapitálu společnosti o částku ve výši 1.200.000 Kč (jeden milion korun českých) ze současné výše základního kapitálu 10.000.000 Kč (deset milionů korun českých) na výši 11.200.000 Kč (jedenáct milionů dvě stě tisíc korun českých) za následujících podmínek:\n(a) upisování nad ani pod tuto částku se nepřipouští;\n(b) základní kapitál bude zvýšen upsáním nové akcie, jejíž emisní kurs bude splacen pouze peněžitým vkladem, s nabídkou upisování akcií určitému zájemci; nová akcie nebude upsána na základě veřejné nabídky;\n(c) zvýšení základního kapitálu bude provedeno upsáním 1 (jednoho) kusu nové akcie zvláštního druhu, a to akcie druhu A, s tímto druhem akcií jsou spojena všechna práva stanovená ZOK pro kmenovou akcii společnosti a dále právo rozhodujícího hlasu (tj. jakékoliv usnesení valné hromady společnosti vyžaduje pro své přijetí hlasy spojené s akcií druhu A, a to bez ohledu na kvorum stanovené ZOK či stanovami, akcie znějící na jméno, o jmenovité hodnotě akcie 1.200.000 Kč (jeden milion korun českých), která bude vydána v listinné podobě;\n(d) akcie nebude upsána s využitím přednostního práva na úpis, jelikož se jediný akcionář společnosti vzdal přednostního práva na úpis. Všechny akcie budou nabídnuty jednomu určitému zájemci, kterým je obchodní společnost Y Soft Corporation, a.s., se sídlem Praha 3, U Kněžské louky 2151/18, PSČ 13000, IČ: 26197740, zapsaná v obchodním rejstříku vedeném Městským soudem v Praze, oddíl B, vložka 16279 (dále jen \"předem určený zájemce\");\n(e) emisní kurs nové akcie o jmenovité hodnotě 1.200.000 Kč (jeden milion korun českých) se bude rovnat její jmenovité hodnotě a bude činit 1.200.000 Kč (jeden milion korun českých) za jednu akcii zvláštního druhu, a to akcie druhu A, s tímto druhem akcií jsou spojena všechna práva stanovená ZOK pro kmenovou akcii společnosti a dále právo rozhodujícího hlasu (tj. jakékoliv usnesení valné hromady společnosti vyžaduje pro své přijetí hlasy spojené s akcií druhu A, a to bez ohledu na kvorum stanovené ZOK či stanovami, akcie znějící na jméno o jmenovité hodnotě jedné akcie 1.200.000 Kč (jeden milion korun českých) vydanou v listinné podobě;\n(f) upisovací lhůta se stanoví na patnáct dnů ode dne přijetí tohoto rozhodnutí o zvýšení základního kapitálu společnosti;\n(g) místem pro upsání akcií je sídlo společnosti Y Soft Ventures, a.s., v budově na adrese Technická 2948/13, Královo Pole, 616 00 Brno, vždy v každý pracovní den lhůty pro upisování akcií od 8.00 hodin do 15.00 hodin;\n(h) akcie bude upsána způsobem uvedeným v § 479 zákona o obchodních korporacích, tedy smlouvou o upsání akcií, která musí mít písemnou formu, podpisy smluvních stran musí být úředně ověřeny a musí obsahovat alespoň náležitosti uvedené v § 479 zákona o obchodních korporacích;\n(i) emisní kurs akcie musí být předem určeným zájemcem zcela splacen nejpozději do dvanácti dnů ode dne upsání akcií, tedy ode dne uzavření smlouvy o upsání akcií, a to na účet č. 2107505964/2700, vedený u obchodní společnosti UniCredit Bank Czech Republic and Slovakia, a.s.;\n(j) upisování nové akcie může začít i dříve, než bude podán návrh na zápis tohoto usnesení o zvýšení základního kapitálu do obchodního rejstříku."},{"datumZapisu":"2015-03-26","hodnota":"Obchodní korporace se podřídila zákonu jako celku postupem podle § 777 odst. 5 zákona č.90/2012 Sb., o obchodních společnostech a družstvech."}],"datumAktualizace":"2026-07-31","stavSubjektu":"AKTIVNI","datumZapisu":"2012-04-02","zpusobRizeni":[{"datumZapisu":"2012-04-02","typ":"DUAL"}],"cinnosti":{"predmetPodnikani":[{"datumZapisu":"2012-04-02","hodnota":"Výroba, obchod a služby neuvedené v přílohách 1 až 3 živnostenského zákona"}]},"ostatniOrgany":[{"datumZapisu":"2012-04-02","nazevOrganu":"Dozorčí rada","pocetClenu":[{"datumZapisu":"2016-02-12","datumVymazu":"2017-07-13","pocetClenu":1,"typ":"CISLEM"},{"datumZapisu":"2017-07-13","pocetClenu":7,"typ":"PRESNY"}],"clenoveOrganu":[{"datumZapisu":"2016-02-12","datumVymazu":"2026-05-29","typAngazma":"DOZORCI_RADA_CLEN","clenstvi":{"clenstvi":{"vznikClenstvi":"2016-02-12","zanikClenstvi":"2021-02-12"},"funkce":{"nazev":"člen dozorčí rady"}},"nazevAngazma":"Člen dozorčí rady","fyzickaOsoba":{"adresa":{"kodStatu":"CZ","nazevStatu":"Česká republika","kodKraje":116,"nazevKraje":"Jihomoravský kraj","kodOkresu":3702,"nazevOkresu":"Brno-město","kodObce":582786,"nazevObce":"Brno","kodMestskeCastiObvodu":551112,"kodUlice":759546,"nazevMestskeCastiObvodu":"Brno-Nový Lískovec","nazevUlice":"Oldřišky Keithové","cisloDomovni":537,"kodCastiObce":411868,"cisloOrientacni":1,"nazevCastiObce":"Nový Lískovec","kodAdresnihoMista":27497127,"psc":63400,"textovaAdresa":"Oldřišky Keithové 537/1, Nový Lískovec, 63400 Brno","standardizaceAdresy":true,"t