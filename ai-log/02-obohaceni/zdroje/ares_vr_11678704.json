nazevStatu":"Česká republika","kodKraje":19,"nazevKraje":"Hlavní město Praha","kodObce":554782,"nazevObce":"Praha","kodSpravnihoObvodu":86,"nazevSpravnihoObvodu":"Praha 8","kodMestskehoObvodu":86,"nazevMestskehoObvodu":"Praha 8","kodMestskeCastiObvodu":500208,"kodUlice":453846,"nazevMestskeCastiObvodu":"Praha 8","nazevUlice":"Kubova","cisloDomovni":535,"kodCastiObce":400637,"cisloOrientacni":2,"nazevCastiObce":"Karlín","kodAdresnihoMista":22354387,"psc":18600,"textovaAdresa":"Kubova 535/2, Karlín, 18600 Praha 8","standardizaceAdresy":true,"typCisloDomovni":1},"typAdresy":"SIDLO"},{"datumZapisu":"2021-10-29","datumVymazu":"2026-07-01","adresa":{"kodStatu":"CZ","nazevStatu":"Česká republika","kodKraje":19,"nazevKraje":"Hlavní město Praha","kodObce":554782,"nazevObce":"Praha","kodSpravnihoObvodu":19,"nazevSpravnihoObvodu":"Praha 1","kodMestskehoObvodu":19,"nazevMestskehoObvodu":"Praha 1","kodMestskeCastiObvodu":500054,"kodUlice":458996,"nazevMestskeCastiObvodu":"Praha 1","nazevUlice":"Na příkopě","cisloDomovni":859,"kodCastiObce":490148,"cisloOrientacni":22,"nazevCastiObce":"Nové Město","kodAdresnihoMista":21706662,"psc":11000,"textovaAdresa":"Na příkopě 859/22, Nové Město, 11000 Praha 1","standardizaceAdresy":true,"typCisloDomovni":1},"typAdresy":"SIDLO"},{"datumZapisu":"2026-07-01","adresa":{"kodStatu":"CZ","nazevStatu":"Česká republika","kodKraje":19,"nazevKraje":"Hlavní město Praha","kodObce":554782,"nazevObce":"Praha","kodSpravnihoObvodu":19,"nazevSpravnihoObvodu":"Praha 1","kodMestskehoObvodu":19,"nazevMestskehoObvodu":"Praha 1","kodMestskeCastiObvodu":500054,"kodUlice":467600,"nazevMestskeCastiObvodu":"Praha 1","nazevUlice":"Revoluční","cisloDomovni":763,"kodCastiObce":400017,"cisloOrientacni":15,"nazevCastiObce":"Staré Město","kodAdresnihoMista":21724342,"psc":11000,"textovaAdresa":"Revoluční 763/15, Staré Město, 11000 Praha 1","standardizaceAdresy":true,"typCisloDomovni":1},"typAdresy":"SIDLO"}],"ostatniSkutecnosti":[{"datumZapisu":"2022-06-20","hodnota":"Valná hromada společnosti Presto Ventures II a.s. rozhodla dne 14.6.2022 o zvýšení základního kapitálu společnosti Presto Ventures II a.s. peněžitým vkladem o částku 30,- Kč, na celkovou částku 2.000.050,- Kč, po zvýšení základního kapitálu společnosti za následujících podmínek:\n(A) Upisování pod ani nad tuto částku se nepřipouští;\n(B) Zvýšení základního kapitálu bude provedeno upsáním 30 kusů nových prioritních akcií se zvláštními právy označených jako Akcie LP znějících na jméno, o jmenovité hodnotě jedné akcie 1,- Kč, které budou všechny vydány v listinné podobě.\nS nově upsanými akciemi označenými jako Akcie LP budou spojena stejná práva jako s akciemi označenými jako Akcie LP již vydanými. \nStávající akcie, jejich druh, forma, podoba a počet zůstávají nezměněny;\n(C) Základní kapitál bude zvýšen upsáním nových akcií, jejichž emisní kurs bude splacen pouze peněžitými vklady, s nabídkou upisování akcií určenému zájemci; nové akcie ani jejich část nebudou upsány na základě veřejné nabídky;\n(D) Akcie nebudou upsány s využitím přednostního práva na úpis, jelikož se všichni akcionáři vzdali přednostního práva na úpis. Všechny akcie budou nabídnuty určenému zájemci, kterým je obchodní společnost Presto 2 GP s.r.o., se sídlem Na příkopě 859/22, Nové Město, 110 00 Praha 1, IČO: 108 03 416, zapsaná v obchodním rejstříku vedeném Městským soudem v Praze, oddíl C, vložka 348743, (dále jen předem určený zájemce nebo společnost Presto 2 GP s.r.o.); která upíše 30 kusů nových prioritních akcií se zvláštními právy označených jako Akcie LP znějících na jméno, o jmenovité hodnotě jedné akcie 1,- Kč, které budou všechny vydány v listinné podobě, při emisním kursu ve výši 1,- Kč za každou akcii.\n(E) Upisování akcií může začít bezodkladně po přijetí tohoto usnesení (počátek běhu upisovací lhůty);\n(F) Lhůta pro upisování akcií se stanoví na 1 (jeden) měsíc. Počátek běhu upisovací lhůty začíná určeným zájemcům běžet doručením návrhu smlouvy o úpisu akcií;\n(G) Místem pro upsání akcií je sídlo společnosti Presto Ventures II a.s., v budově na adrese Na příkopě 859/22, Nové Město, 110 00 Praha 1, vždy v každý pracovní den lhůty pro upisování akcií od 8:00 hodin do 17:00 hodin, pokud se společnost Presto Ventures II a.s. a předem určení zájemci nedohodnou jinak;\n(H) Akcie budou upsány způsobem uvedeným v ustanovení § 479 zákona o obchodních korporacích, tedy smlouvou o úpisu akcií, která musí mít písemnou formu, podpisy smluvních stran musí být úředně ověřeny a musí obsahovat alespoň náležitosti uvedené v ustanovení § 479 zákona o obchodních korporacích. K úpisu akcií bude předem určeným zájemcům poskytnuta lhůta 1 (jednoho) měsíce od doručení návrhu na uzavření smlouvy o úpisu akcií;\n(I) Emisní kurs akcií upsaných společností Presto 2 GP s.r.o. bude splacen společností Presto 2 GP s.r.o. bezhotovostním převodem na bankovní účet společnosti číslo: 299716539/0300, vedený u obchodní společnosti Československá obchodní banka, a. s., a to nejpozději do 30 (třiceti) dnů od úpisu akcií, tj. ode dne uzavření smlouvy o úpisu akcií. K okamžiku zápisu změny výše základního kapitálu společnosti Presto Ventures II a.s. do obchodního rejstříku musí být emisní kurs upsaných akcií zcela splacen."}],"datumAktualizace":"2026-09-26","stavSubjektu":"AKTIVNI","datumZapisu":"2021-07-21","zpusobRizeni":[{"datumZapisu":"2021-07-21","typ":"DUAL"}],"cinnosti":{"predmetPodnikani":[{"datumZapisu":"2021-07-21","datumVymazu":"2022-06-20","hodnota":"Výroba, obchod a služby neuvedené v přílohách 1 až 3 živnostenského zákona"},{"datumZapisu":"2022-06-20","hodnota":"Výroba, obchod a služby neuvedené v přílohách 1 až 3 živnostenského zákona, v následujících oborech činnosti:\n- Nákup, prodej, správa a údržba nemovitostí\n- Pronájem a půjčování věcí movitých\n- Zprostředkování obchodu a služeb\n- Poradenská a konzultační činnost, zpracování odborných studií a posudků\n- Reklamní činnost, marketing, mediální zastoupení\n- Služby v oblasti administrativní správy a služby organizačně hospodářské povahy"}],"predmetCinnosti":[{"datumZapisu":"2021-07-21","hodnota":"Pronájem nemovitostí, bytů a nebytových prostor"},{"datumZapisu":"2021-07-21","hodnota":"Správa vlastního majetku"}]},"ostatniOrgany":[{"datumZapisu":"2021-07-21","nazevOrganu":"Dozorčí rada","pocetClenu":[{"datumZapisu":"2021-07-21","datumVymazu":"2026-07-01","pocetClenu":1,"typ":"PRESNY"},{"datumZapisu":"2026-07-01","pocetClenu":5,"typ":"PRESNY"}],"clenoveOrganu":[{"datumZapisu":"2021-07-21","datumVymazu":"2024-11-29","typAngazma":"DOZORCI_RADA_CLEN","clenstvi":{"clenstvi":{"vznikClenstvi":"2021-07-21","zanikClenstvi":"2024-11-28"},"funkce":{"nazev":"Člen dozorčí rady"}},"nazevAngazma":"Člen dozorčí rady","fyzickaOsoba":{"adresa":{"kodStatu":"CZ","nazevStatu":"Česká republika","kodKraje":116,"nazevKraje":"Jihomoravský kraj","kodOkresu":3703,"nazevOkresu":"Brno-venkov","kodObce":582930,"nazevObce":"Čučice","cisloDomovni":98,"kodCastiObce":24376,"nazevCastiObce":"Čučice","kodAdresnihoMista":24933040,"psc":66491,"textovaAdresa":"č.p. 98, 66491 Čučice","standardizaceAdresy":true,"typCisloDomovni":1},"datumNarozeni":"1993-12-28","jmeno":"ROMAN","prijmeni":"NOVÁČEK"}},{"datumZapisu":"2024-11-29","datumVymazu":"2026-07-01","typAngazma":"DOZORCI_RADA_CLEN","clenstvi":{"clenstvi":{"vznikClenstvi":"2024-11-28","zanikClenstvi":"2026-06-25"},"funkce":{"nazev":"Člen dozorčí rady"}},"nazevAngazma":"Člen dozorčí rady","fyzickaOsoba":{"adresa":{"kodStatu":"CZ","nazevStatu":"Česká republika","kodKraje":19,"nazevKraje":"Hlavní město Praha","kodObce":554782,"nazevObce":"Praha","kodSpravnihoObvodu":108,"nazevSpravnihoObvodu":"Praha 10","kodMestskehoObvodu":108,"nazevMestskehoObvodu":"Praha 10","kodMestskeCastiObvodu":500224,"kodUlice":444448,"nazevMestskeCastiObvodu":"Praha 10","nazevUlice":"Bulharská","cisloDomovni":1213,"kodCastiObce":490237,"cisloOrientacni":21,"nazevCastiObce":"Vršovice","kodAdresnihoMista":22669281,"psc":10100,"textovaAdresa":"Bulharská 1213/21, Vršovice, 10100 Praha 10","standardi